{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node ~/.claude/hooks/cc-mode.mjs",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node ~/.claude/hooks/cc-mode.mjs",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node ~/.claude/hooks/cc-mode.mjs",
						"timeout": 5
					}
				]
			}
		]
	}
}
